#!/bin/sh

# php-fpm master must run as root so workers can drop to www-data.
# exec so SIGTERM from /sbin/my_init reaches php-fpm (not this shell).
# runit requires a foreground process: daemonize = no in php-fpm.conf.

exec /usr/local/php/sbin/php-fpm --nodaemonize --fpm-config /usr/local/php/etc/php-fpm.conf
