# MariaDB 12.3 option file
#
# 运行环境：
#   CPU(s): 4 vCPU
#   Mem: 4 GiB
#   Disk: 100 GiB SSD
#   OS: Ubuntu 24.04
#   arch: x86_64
#   timezone: Asia/Shanghai
#   MariaDB Version: 12.3.3，源码编译
#   类型：独立数据库，单实例，非 Galera
#
# 访问方式：优先 TCP（本机/局域网/公网 IP + 3306），socket 仅作备选。
# 客户端默认 host=127.0.0.1 且 protocol=tcp，避免连 localhost 时走 Unix socket。
# 不要把客户端 host 写成 0.0.0.0（那是服务端 bind-address）。
# 需要 socket 时必须同时覆盖 host：否则 127.0.0.1 仍走 TCP，且 skip_name_resolve 下对不上 root@localhost。
# /usr/local/mysql/bin/mariadb -h localhost --protocol=socket -u root
#
# InnoDB:  https://mariadb.com/docs/server/server-usage/storage-engines/innodb/innodb-system-variables.md
# Charset: https://mariadb.com/docs/server/reference/data-types/string-data-types/character-sets/setting-character-sets-and-collations.md

[client-server]
port                                 = 3306
socket                               = /wwwdata/mysql/run/mysql.sock

[client]
host                                 = 127.0.0.1
protocol                             = tcp
default-character-set                = utf8mb4

[client-mariadb]
host                                 = 127.0.0.1
protocol                             = tcp
default-character-set                = utf8mb4

[mariadbd]
user                                 = www-data
basedir                              = /usr/local/mysql
datadir                              = /wwwdata/mysql/data
tmpdir                               = /tmp
pid-file                             = /wwwdata/mysql/run/mariadb.pid
bind-address                         = 0.0.0.0
skip_name_resolve                    = ON
default-time-zone                    = '+8:00'

# MariaDB 11.6+: utf8mb4 / utf8mb4_uca1400_ai_ci
character-set-server                 = utf8mb4
collation-server                     = utf8mb4_uca1400_ai_ci

tls_version                          = TLSv1.2,TLSv1.3

max_connections                      = 200
max_allowed_packet                   = 64M

# --------------------------
# Logging
# --------------------------
log_error                            = /wwwdata/mysql/run/error.log
general_log                          = OFF
general_log_file                     = /wwwdata/mysql/run/general.log
slow_query_log                       = ON
long_query_time                      = 2
slow_query_log_file                  = /wwwdata/mysql/run/slow.log

# PITR / replication. Basename avoids hostname-dependent log names.
log_bin                              = mariadb-bin
binlog_format                        = MIXED
sync_binlog                          = 1
binlog_expire_logs_seconds           = 1209600

# --------------------------
# InnoDB
# --------------------------
innodb_buffer_pool_size              = 1536M
innodb_log_file_size                 = 256M
innodb_flush_log_at_trx_commit       = 1
innodb_data_file_buffering           = OFF
innodb_data_file_write_through       = OFF
innodb_log_file_buffering            = OFF
innodb_log_file_write_through        = OFF
innodb_use_native_aio                = ON
innodb_linux_aio                     = io_uring
innodb_doublewrite                   = ON

[mariadb-client]
host                                 = 127.0.0.1
protocol                             = tcp
default-character-set                = utf8mb4
local-infile                         = 0
safe-updates                         = 1
max-allowed-packet                   = 64M

[mariadb-dump]
host                                 = 127.0.0.1
protocol                             = tcp
default-character-set                = utf8mb4
max-allowed-packet                   = 64M
quick                                = 1
comments                             = 1

[mariadb-import]
host                                 = 127.0.0.1
protocol                             = tcp
default-character-set                = utf8mb4

[mariadb-check]
host                                 = 127.0.0.1
protocol                             = tcp
default-character-set                = utf8mb4

[mariadb-upgrade]
host                                 = 127.0.0.1
protocol                             = tcp
default-character-set                = utf8mb4

[mariadb-show]
host                                 = 127.0.0.1
protocol                             = tcp
default-character-set                = utf8mb4
