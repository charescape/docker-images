#!/bin/sh

# `/sbin/setuser www-data` runs valkey-server as www-data.
# exec so SIGTERM from /sbin/my_init reaches valkey-server (not this shell).
# runit requires a foreground process: daemonize no in valkey.conf.

ACLFILE=/wwwdata/misc/users.acl
if [ ! -f "$ACLFILE" ]; then
  echo "missing ${ACLFILE}" >&2
  exit 1
fi

exec /sbin/setuser www-data /usr/local/valkey/bin/valkey-server /wwwdata/valkey/run/valkey.conf
